# Copy to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# Where JSON data is stored. Local default: ./data   Render: /data (persistent disk mount)
DATA_DIR=./data

# Port (Render sets this automatically)
PORT=4000

# Secret used to sign admin sessions. Use a long random string (at least 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial admin account: created on first start only, stored as a bcrypt hash.
# Remove ADMIN_PASSWORD after the first successful start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to true (together with ADMIN_PASSWORD) to reset a forgotten password on next start, then remove both.
ADMIN_RESET_PASSWORD=

# Brevo (same variables as the existing Orange Tree LMS integration)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Orange Tree LMS

# Public URL used in prize links. Optional on Render (RENDER_EXTERNAL_URL is used automatically).
# Local dev with Vite: http://localhost:5173
PUBLIC_BASE_URL=
