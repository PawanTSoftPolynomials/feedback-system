{
  "name": "orange-tree-feedback-system",
  "version": "1.0.0",
  "private": true,
  "description": "Feedback management website and prize selection portal (Express + React, JSON file storage).",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "test": "node --test server/test/api.test.js server/test/sync.test.js",
    "backup": "node server/scripts/backup.js",
    "restore": "node server/scripts/restore.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  }
}
